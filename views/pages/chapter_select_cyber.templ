package pages

import "cyber-security-minigames/views/layouts"

templ CyberChapterSelect() {
	@layouts.Base("Chapter Select - Caught in the Net") {
		<main class="cyber-chapter-select">

			<a
				class="ui-back-button"
				href="/"
				hx-boost="false"
				aria-label="Back to home"
			></a>

			<div class="cyber-chapter-select__scene">

				<div class="cyber-chapter-select__grid">

					<a class="cyber-chapter-select__item" href="/comic/password">
						<img
							src="/public/images/chapter-select-cyber/password.png"
							alt="Password"
						/>
						<span>PASSWORDS</span>
					</a>

					<a class="cyber-chapter-select__item" href="/comic/privacy">
						<img
							src="/public/images/chapter-select-cyber/privacy.png"
							alt="Online Privacy"
						/>
						<span>ONLINE PRIVACY</span>
					</a>

					<a class="cyber-chapter-select__item" href="/comic/phishing">
						<img
							src="/public/images/chapter-select-cyber/phishing.png"
							alt="Phishing"
						/>
						<span>PHISHING</span>
					</a>

					<a class="cyber-chapter-select__item" href="/comic/encryption">
						<img
							src="/public/images/chapter-select-cyber/encryption.png"
							alt="Encryption"
						/>
						<span>ENCRYPTION</span>
					</a>

					<a class="cyber-chapter-select__item" href="/comic/network-defense">
						<img
							src="/public/images/chapter-select-cyber/network-defence.png"
							alt="Network Defence"
						/>
						<span>NETWORK DEFENCE</span>
					</a>

					<a class="cyber-chapter-select__item" href="/comic/digital-investigation">
						<img
							src="/public/images/chapter-select-cyber/digital-investigation.png"
							alt="Digital Investigation"
						/>
						<span>DIGITAL INVESTIGATION</span>
					</a>

				</div>

			</div>

		</main>
	}
}