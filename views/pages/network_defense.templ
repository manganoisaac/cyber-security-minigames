package pages

import "cyber-security-minigames/views/layouts"

templ NetworkDefensePage() {
	@layouts.Base("Metacortex NOC - Perimeter Defense") {
		<main class="network-defense" id="network-defense-game">
			<header class="network-defense__briefing">
				<h1>Perimeter defense</h1>
				<p>
					Metacortex's outbound transfer is still scheduled. Hold the perimeter
					and stop the intrusion before it reaches the core.
				</p>
			</header>

			<div class="network-defense__layout">
				<section class="network-defense-panel network-defense-panel--build" aria-labelledby="nd-build-heading">
					<h2 id="nd-build-heading">Deploy defenses</h2>
					<p class="network-defense-panel__hint">Select a defense, then choose a highlighted node to place it.</p>
					<div
						id="nd-tower-list"
						class="network-defense-tower-list"
						role="group"
						aria-label="Available defenses"
					></div>
					<p class="network-defense-selected-info" id="nd-selected-info" aria-live="polite">
						Nothing selected. Choose a defense above.
					</p>
					<div class="network-defense-threat-legend">
						<h3>Threat reference</h3>
						<ul id="nd-threat-legend" class="network-defense-threat-legend__list"></ul>
					</div>
				</section>

				<section class="network-defense-panel network-defense-panel--battlefield" aria-labelledby="nd-battlefield-heading">
					<div class="network-defense-battlefield__header">
						<h2 id="nd-battlefield-heading">Perimeter topology</h2>
						<div class="network-defense-battlefield__stats">
							<span id="nd-wave-label">Wave 0 / 0</span>
							<span id="nd-credits-label">Credits: 0</span>
						</div>
					</div>
					<div
						id="nd-grid"
						class="network-defense-grid"
						aria-label="Network perimeter grid, edge to core"
					></div>
					<div class="network-defense-battlefield__footer">
						<p class="network-defense-legend">
							<span>Path tile - traffic travels here</span>
							<span>Buildable node - place a defense</span>
						</p>
						<p class="network-defense-upcoming" id="nd-upcoming-preview" aria-live="polite"></p>
						<button type="button" id="nd-launch-wave" class="network-defense-launch-button">
							Launch wave
						</button>
					</div>
				</section>

				<section class="network-defense-panel network-defense-panel--telemetry" aria-labelledby="nd-telemetry-heading">
					<h2 id="nd-telemetry-heading">Core status</h2>

					<div class="network-defense-integrity">
						<div class="network-defense-integrity__row">
							<span>Network integrity</span>
							<strong id="nd-integrity-text">100%</strong>
						</div>
						<div class="network-defense-integrity__track" aria-hidden="true">
							<div class="network-defense-integrity__fill" id="nd-integrity-bar"></div>
						</div>
					</div>

					<div class="network-defense-threat">
						<div class="network-defense-threat__row">
							<span>Threat level</span>
							<strong id="nd-threat-text">Standing by</strong>
						</div>
						<div class="network-defense-threat__track" aria-hidden="true">
							<div class="network-defense-threat__fill" id="nd-threat-bar"></div>
						</div>
					</div>

					<div class="network-defense-log">
						<h3>Live event log</h3>
						<ul id="nd-event-log" class="network-defense-log__list" aria-live="polite"></ul>
					</div>
				</section>
			</div>

			<!-- Start instructions -->
			<div class="network-defense-modal-overlay" id="nd-instructions-modal">
				<section class="network-defense-modal" role="dialog" aria-modal="true" aria-labelledby="nd-instructions-title">
					<h2 id="nd-instructions-title">Hold the perimeter</h2>
					<p>
						An intrusion attempt is inbound. Place defenses along the network path
						to stop hostile traffic before it reaches the core server.
					</p>
					<ul class="network-defense-instructions-rules">
						<li>Choose a defense, then click a highlighted node next to the path to deploy it.</li>
						<li>Each defense only stops one kind of traffic - check "Threat reference" to plan ahead. Anything you have no matching defense for will reach the core untouched.</li>
						<li>Each defense costs credits. Earn more by stopping traffic.</li>
						<li>Click "Launch wave" when you're ready - defenses fire automatically once a wave begins.</li>
						<li>If network integrity reaches zero, the core is breached.</li>
					</ul>
					<div class="network-defense-modal__actions">
						<button type="button" class="network-defense-button network-defense-button--primary" id="nd-begin-button">
							Begin operation
						</button>
					</div>
				</section>
			</div>

			<!-- End-of-game result dialog -->
			<div class="network-defense-modal-overlay" id="nd-result-modal" hidden>
				<section class="network-defense-modal" role="dialog" aria-modal="true" aria-labelledby="nd-result-title">
					<h2 id="nd-result-title">Operation complete</h2>
					<p id="nd-result-message"></p>
					<div class="network-defense-modal__actions">
						<button type="button" class="network-defense-button network-defense-button--primary" id="nd-result-button">
							Try again
						</button>
					</div>
				</section>
			</div>

			<script src="/public/js/network-defense-game.js"></script>
		</main>
	}
}
