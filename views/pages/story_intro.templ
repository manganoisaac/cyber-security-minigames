package pages

import "cyber-security-minigames/views/layouts"

templ StoryIntro() {
	@layouts.Base("A New Case - Caught in the Net") {
		<main class="story-intro-page">
			<div class="story-intro-board">
				<div class="story-intro-board__content">
					<header class="story-intro-header">
						<p class="story-intro-kicker">PRIVATE INVESTIGATOR'S CASE NOTES</p>
						<h1>A NEW CASE</h1>
					</header>

					<section class="story-intro-copy" aria-label="Case introduction">
						<p>
							It is the early 21st century. Beneath the neon glow of a city that never really sleeps,
							you make your living as a private investigator, taking the cases nobody else wants and
							following leads wherever they take you.
						</p>

						<p>
							One night, a woman named <strong>Angela Bennett</strong> arrives at your office.
							She has been accused of a serious cybercrime, but she swears she was framed.
							Angela does not have much to go on, only the name of a coworker whose recent behaviour
							has made her suspicious: <strong>Eugene</strong>.
						</p>

						<p>
							It is not much of a lead, but sometimes that is all a detective gets. Angela tells you
							where Eugene's computer can be found, and you agree to take the case. Somewhere in his
							digital trail is the truth, and it is up to you to uncover it.
						</p>
					</section>

					<section class="story-intro-welcome">
						<span>WELCOME TO...</span>
						<strong>CAUGHT IN THE NET</strong>
					</section>

					<footer class="story-intro-footer">
						<a
							class="story-intro-continue"
							href="/comic/password"
							hx-boost="false"
						>
							BEGIN THE INVESTIGATION →
						</a>
					</footer>
				</div>
			</div>
		</main>
	}
}
