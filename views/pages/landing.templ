package pages

import "cyber-security-minigames/views/layouts"

templ Landing() {
	@layouts.Base("Cyber Security Minigames") {
		<main id="landing-page-bg">
			<section class="menu">
				<img src="../../public/images/Title.png" class="heading-img"/>
				<a class="img-button">Start Investigation</a>
				<a class="img-button" href="chapter-select">Start Chapter</a>
			</section>
		</main>
	}
}
