package pages

import "cyber-security-minigames/views/layouts"

templ Landing() {
	@layouts.Base("Cyber Security Minigames") {
		<main class="landing">
			<section class="landing__menu">
				<img src="../../public/images/Title.png" class="landing__title"/>
				<a class="landing__button">Start Investigation</a>
				<a class="landing__button" href="chapter-select">Start Chapter</a>
			</section>
		</main>
	}
}
