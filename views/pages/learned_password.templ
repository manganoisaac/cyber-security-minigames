package pages

import (
	"cyber-security-minigames/views/layouts"
	whwl "cyber-security-minigames/views/components/what_have_we_learned"
)

templ PasswordLearnedPage() {
	@layouts.Base("What Have We Learned? - Passwords & Social Engineering") {
		@whwl.WhatHaveWeLearnedPage(whwl.PageData{
			Topic: "Passwords & Social Engineering",

			StoryHeading: "CASE UPDATE",

			StoryParagraphs: []string{
				"You searched Eugene's office for personal clues and used what you found to work out his password, giving you access to his workstation.",

				"The investigation also uncovered several important records about Eugene. He had recently been rejected for a Senior Developer promotion, and soon afterwards his application to join Project HELIOS was also rejected.",

				"Just days later, Metacortex announced the final HELIOS development team, and Angela Bennett had been selected instead of Eugene.",

                "These clues reveal growing tensions between Eugene and Metacortex.",

			},

			LessonHeading: "PASSWORDS & SOCIAL ENGINEERING",

			LessonParagraphs: []string{
				"Attackers do not always need sophisticated hacking tools to compromise an account. If a password is based on names, interests, dates, workplaces or other personal information, an attacker may be able to guess it simply by learning enough about the person.",

				"Social engineering uses information about a person to help bypass security rather than attacking the technology directly.",
			},

			Connections: []whwl.LearningConnection{
				{
					PlayerAction:     "Searched Eugene's environment for personal clues",
					RealWorldMeaning: "Attackers may gather information from workplaces, conversations, social media and other sources before attempting to access an account",
				},
				{
					PlayerAction:     "Combined those clues to predict his password",
					RealWorldMeaning: "Passwords based on personal information are easier to guess, even when they look complicated to the person who created them",
				},
				{
					PlayerAction:     "Used the password to access his computer",
					RealWorldMeaning: "If an account relies only on a password, compromising that password may be enough to gain access. Multi-factor authentication adds another barrier",
				},
			},

			KeyTakeaway:
				"Use long, unique passwords or passphrases that are not based on personal information. A password manager and multi-factor authentication can provide additional protection.",

			ContinueLabel: "Continue",
			ContinueHref: "/comic/privacy",
		})
	}
}