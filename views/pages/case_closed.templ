package pages

import "cyber-security-minigames/views/layouts"

templ CaseClosedPage() {
	@layouts.Base("Case Closed - Caught in the Net") {
		<main class="case-closed-page">
			<div class="case-closed-content">

				<h1>CONGRATULATIONS!</h1>

				<p class="case-closed-message">
					You completed the investigation and closed the Metacortex case.
				</p>

				<p class="case-closed-thanks">
					Thank you for playing <strong>Caught in the Net</strong>.
					We hope you learned something about how cybersecurity works in the real world.
				</p>

				<!-- Placeholder for a future pixel-art image -->
				<div class="case-closed-art"></div>

				<div class="case-closed-stamp">
					CASE CLOSED
				</div>

				<a class="case-closed-button" href="/">
					Return to Main Menu
				</a>

			</div>
		</main>
	}
}