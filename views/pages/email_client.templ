package pages

import "cyber-security-minigames/views/layouts"
import "cyber-security-minigames/views/components/email"
import "cyber-security-minigames/views/components/ui"
import "cyber-security-minigames/types"

templ EmailClientPage(emails []types.Email, active types.Email, selectedPhrases map[int]bool, level int, intro string, instructions string, revealed bool) {
	@layouts.Base("CyberMail - MetaCortex Industries") {
		<main class="email-client-page">
			@ui.BackButton()

			<div class="email-client-page__level-badge">
				if level == 1 {
					LEVEL 1 - IDENTIFY THE PHISHING EMAIL
				} else {
					LEVEL 2 - ANALYSE THE PHISHING EMAIL
				}
			</div>

			@email.EmailClient(emails, active, selectedPhrases, level, revealed)
		</main>

		<div id="modal-root">
			if level == 1 && intro != "" {
				@email.EmailModal("Phishing & Social Engineering", intro, "Continue", "/phishing/instructions", false)
			} else if instructions != "" {
				@email.EmailModal("Analyse the Phishing Email", instructions, "Begin", "", false)
			}
		</div>
	}
}
