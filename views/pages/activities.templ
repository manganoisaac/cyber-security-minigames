package pages

import (
	"strconv"

	"cyber-security-minigames/views/components"
	"cyber-security-minigames/views/layouts"
)

// ActivityLink is a single entry in the activities menu.
type ActivityLink struct {
	Slug      string
	Number    int
	Title     string
	Topic     string
	Completed bool // placeholder; no tracking mechanism wired up yet
}

// Activities is the ordered list of activities. The menu below and the
// routes in internal/handlers/games.go are both built from this one
// list, so adding an activity here wires it up everywhere. Titles,
// topics, and the icon shown (see views/components/banners.templ) are
// placeholders — adjust to match the final narrative.
var Activities = []ActivityLink{
	{Slug: "phishing", Number: 1, Title: "Phishing Investigation", Topic: "Email security"},
	{Slug: "password", Number: 2, Title: "Password & Environmental", Topic: "Password security"},
	{Slug: "privacy", Number: 3, Title: "Online Privacy", Topic: "Digital footprint"},
	{Slug: "encryption", Number: 4, Title: "Encryption Bridge", Topic: "Encryption"},
	{Slug: "network", Number: 5, Title: "Network Defence", Topic: "Network security"},
	{Slug: "investigation", Number: 6, Title: "Final Investigation", Topic: "Evidence & reasoning"},
}

templ ActivitiesIndex() {
	@layouts.Base("Activities") {
		<section class="activities">
			<div class="activities-hero">
				<h1>Case Files</h1>
			</div>
			<ul class="activity-list">
				for _, a := range Activities {
					<li>
						<a class="activity-card" href={ templ.SafeURL("/activity/" + a.Slug) }>
							@components.Banner(a.Slug)
							<div class="activity-card-body">
								<span class="num">Case { strconv.Itoa(a.Number) }</span>
								<span class="title">{ a.Title }</span>
								@components.StatusPill(a.Completed)
							</div>
						</a>
					</li>
				}
			</ul>
		</section>
	}
}
