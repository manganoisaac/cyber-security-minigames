package pages

import "cyber-security-minigames/views/layouts"

templ ChapterSelect() {
	@layouts.Base("Cyber Security Minigames") {
		<main id="chapter-select-bg">
			<a class="back-arrow" href="/">Home</a>
			<div class="book">
				<h3 class="chapter-select cs-1">Phishing</h3>
				<h3 class="chapter-select cs-2">Passwords</h3>
				<h3 class="chapter-select cs-3">Online Privacy</h3>
				<h3 class="chapter-select cs-4">Encryption</h3>
				<h3 class="chapter-select cs-5">Network & Defense</h3>
				<h3 class="chapter-select cs-6">Digital<br/>Investigation</h3>
			</div>
		</main>
	}
}
