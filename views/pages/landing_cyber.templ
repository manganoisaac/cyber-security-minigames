package pages

import "cyber-security-minigames/views/layouts"

templ CyberLanding() {
	@layouts.Base("Caught in the Net") {
		<main class="cyber-landing">
			<div class="cyber-landing__scene">
				<div class="cyber-landing__title-wrap">
					<h1
						class="cyber-landing__title"
						data-text="CAUGHT IN THE NET"
					>
						CAUGHT IN THE NET
					</h1>
				</div>
				<nav class="cyber-landing__menu" aria-label="Main menu">
					<a class="cyber-landing__menu-item" href="/story-intro">
						[ START INVESTIGATION ]
					</a>
					<a class="cyber-landing__menu-item" href="/chapter-select">
						[ CHAPTER SELECT ]
					</a>
				</nav>
			</div>
		</main>
	}
}
