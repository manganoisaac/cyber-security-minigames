package pages

import "cyber-security-minigames/types"
import "cyber-security-minigames/views/layouts"
import "cyber-security-minigames/views/components/password"

templ PasswordPage(view types.PasswordView, guesses []types.Guess, numPositions int, instructions string) {
	@layouts.Base("Password Game") {
		@password.PasswordMain(view, guesses, numPositions, instructions)
	}
}
