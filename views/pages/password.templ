package pages

import "cyber-security-minigames/types"
import "cyber-security-minigames/views/layouts"
import "cyber-security-minigames/views/components/password"
import "cyber-security-minigames/views/components/ui"

templ PasswordPage(view types.PasswordView, guesses []types.Guess, numPositions int, instructions string) {
	@layouts.Base("Password Game") {
		<main class={ "password password--" + view.String() }>
			if view != types.PasswordOffice {
				<a class="password__back-arrow" href="/password/changeview/0">Back</a>
			}
			switch view {
				case types.PasswordDesk:
					@password.ObjectContainer(3, 2, types.PasswordNone)
				default:
					@password.ObjectContainer(0, 3, types.PasswordDesk)
			}
			@password.Guess(guesses, numPositions)
		</main>
		<div id="modal-root" hx-preserve="true">
			if instructions != "" {
				@ui.Modal(instructions, "", false)
			}
		</div>
	}
}
