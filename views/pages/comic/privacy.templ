package comic

import (
	comiccomp "cyber-security-minigames/views/components/comic"
	"cyber-security-minigames/views/layouts"
)

templ PrivacyComicPage() {
	@layouts.Base("Caught in the Net - Online Privacy") {
		@comiccomp.ComicPage(comiccomp.ComicData{
			PanelImages: []string{
				"/public/images/comics/Game_2/image-1.png",
				"/public/images/comics/Game_2/image-2.png",
				"/public/images/comics/Game_2/image-3.png",
			},
			ContinueHref:  "/privacy",
			ContinueLabel: "Continue",
		})
	}
}