package comic

import (
	comiccomp "cyber-security-minigames/views/components/comic"
	"cyber-security-minigames/views/layouts"
)

templ DigitalInvestigationComicPage() {
	@layouts.Base("Story Comic - Digital Investigation") {
		@comiccomp.ComicPlaceholder(comiccomp.PlaceholderData{
			Title:        "Digital Investigation",
			ContinueHref: "/digital-investigation",
		})
	}
}