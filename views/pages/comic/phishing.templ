package comic

import (
	comiccomp "cyber-security-minigames/views/components/comic"
	"cyber-security-minigames/views/layouts"
)

templ PhishingComicPage() {
	@layouts.Base("Story Comic - Phishing") {
		@comiccomp.ComicPlaceholder(comiccomp.PlaceholderData{
			Title:        "Phishing",
			ContinueHref: "/email-client",
		})
	}
}