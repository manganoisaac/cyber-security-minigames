package pages

import (
	"strconv"

	"cyber-security-minigames/views/layouts"
)

// ActivityMeta is the shared header info every activity page needs.
type ActivityMeta struct {
	Number int
	Title  string
	Topic  string
	Recap  string // "Previously…" text; leave empty when played in sequence
}

// Activity is the reusable shell for all six activities. Each activity's
// interactive content goes in the { children... } slot, e.g.:
//
//	@pages.Activity(meta) {
//		<!-- the phishing inbox, the network board, etc. -->
//	}
//
// Rendered on its own (as the routes currently do), it shows the header
// and recap with an empty body — a working placeholder to build into.
templ Activity(meta ActivityMeta) {
	@layouts.Base(meta.Title) {
		<article class="activity">
			<header class="activity-head">
				<span class="activity-num">Case { strconv.Itoa(meta.Number) }</span>
				<h1>{ meta.Title }</h1>
				<p class="topic">{ meta.Topic }</p>
			</header>
			if meta.Recap != "" {
				<aside class="recap">
					<h2>Previously…</h2>
					<p>{ meta.Recap }</p>
				</aside>
			}
			<section class="activity-body">
				{ children... }
			</section>
		</article>
	}
}
