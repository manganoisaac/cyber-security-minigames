package pages

import "cyber-security-minigames/views/layouts"
import "cyber-security-minigames/views/components/password"
import "cyber-security-minigames/types"
import "cyber-security-minigames/views/components/ui"

templ PasswordLevel2Page(hints []string, guesses []types.Guess) {
	@layouts.Base("Password Level 2") {
		@password.Level2(hints, guesses)
		<div id="modal-root">
			@ui.Modal(`Click on the clues to find the password.
      Click the "backspace" button to clear your search.`, "", false)
		</div>
	}
}
