				<li><strong>Cody Perkins</strong>: UI/UX Designer</li>
				<li><strong>Taylor Campbell</strong>: Tester</li>
				<li><strong>David Pearsall</strong>: Activity &amp; Content Designer</li>
				<li><strong>Jeremy Goodger</strong>: Integration &amp; Deployment Lead</li>
			</ul>
		</section>
	}
}
