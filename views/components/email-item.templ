package components

import "cyber-security-minigames/types"
import "cyber-security-minigames/utils/textmanipulation"
import "strconv"

templ EmailItem(index int, email types.EmailItemProps, selected bool) {
	<div
		class={ "email-item-container", templ.KV("email-item-selected", selected) }
		hx-get={ "/email/" + strconv.Itoa(index) }
		hx-target="#email-list-container"
		hx-swap="outerHTML"
		hx-trigger="click"
	>
		@EmailAvatar(index, email.Subject)
		<div class="email-item-text">
			<h3>{ textmanipulation.TruncateChars(email.Title, 20) }</h3>
			<h4>{ textmanipulation.TruncateChars(email.Subject, 30) }</h4>
			<p>{ textmanipulation.TruncateChars(email.Content, 50) }</p>
		</div>
		<p class="email-timestamp"><b>4 Aug</b></p>
	</div>
}
