package components

templ EmailItem() {
	<div class="email-item-container">
		<img class="avatar" src="https://placehold.co/600x400"/>
		<div class="email-item-text">
			<h3>Title</h3>
			<h4>An email description</h4>
			<p>All the email content...</p>
		</div>
		<p class="email-timestamp"><b>4 Aug</b></p>
	</div>
}
