package password

import "cyber-security-minigames/views/components/ui"

templ PasswordMain() {
	<main class="password-game" id="password-game">
		@ui.BackButton()

		<!-- =====================================================
		     PHASE 1 - OFFICE INVESTIGATION
		====================================================== -->
		<section class="password-game__phase password-game__phase--office" id="password-phase-office">
			<img
				class="password-game__scene-image"
				src="/public/images/password/office.png"
				alt="Eugene's office"
			/>

			<div class="password-game__office-hotspots" aria-label="Search Eugene's office for clues">
				<button class="password-game__office-hotspot password-game__office-hotspot--jersey" type="button" data-clue-id="jersey" aria-label="Inspect the framed jersey"></button>
				<button class="password-game__office-hotspot password-game__office-hotspot--dog" type="button" data-clue-id="rufus" aria-label="Inspect the dog photograph"></button>
				<button class="password-game__office-hotspot password-game__office-hotspot--drawing" type="button" data-clue-id="mia" aria-label="Inspect the child's drawing"></button>
				<button class="password-game__office-hotspot password-game__office-hotspot--calendar" type="button" data-clue-id="april9" aria-label="Inspect the calendar"></button>
				<button class="password-game__office-hotspot password-game__office-hotspot--drawer" type="button" data-clue-id="birthday" aria-label="Inspect the open desk drawer"></button>
			</div>

			<button class="password-game__notebook-icon" id="password-notebook-icon" type="button" aria-label="Open case notes">
				<img src="/public/images/password/Notepad Icon.png" alt=""/>
				<span>CASE NOTES</span>
				<strong id="password-notebook-count">0 / 5</strong>
			</button>
		</section>

		<!-- =====================================================
		     PHASE 2 - PASSWORD RECONSTRUCTION
		====================================================== -->
		<section class="password-game__phase password-game__phase--login" id="password-phase-login" hidden>
			<img
				class="password-game__scene-image"
				src="/public/images/password/login.png"
				alt="Metacortex employee portal login screen"
			/>

			<div class="password-game__login-controls" aria-label="Password reconstruction">
				<div class="password-game__password-slots" id="password-slots">
					<button class="password-game__password-slot" type="button" data-slot-index="0" aria-label="Password part 1"></button>
					<button class="password-game__password-slot" type="button" data-slot-index="1" aria-label="Password part 2"></button>
					<button class="password-game__password-slot" type="button" data-slot-index="2" aria-label="Password part 3"></button>
				</div>

				<button class="password-game__login-button" id="password-login-button" type="button" disabled>
					LOGIN
				</button>
				<p class="password-game__login-status" id="password-login-status">Match all three password parts to enable login.</p>
			</div>

			<aside class="password-game__phase2-notebook" aria-label="Case notes">
				<img src="/public/images/password/Notepad.png" alt="Case notes notebook"/>
				<div class="password-game__phase2-clues" id="password-phase2-clues"></div>
			</aside>
		</section>

		<!-- =====================================================
		     ZOOMED CLUE VIEW
		====================================================== -->
		<div class="password-game__zoom" id="password-zoom" hidden>
			<button class="password-game__zoom-backdrop" id="password-zoom-backdrop" type="button" aria-label="Return to office"></button>
			<div class="password-game__zoom-frame" id="password-zoom-frame">
				<img class="password-game__zoom-image" id="password-zoom-image" src="" alt=""/>
				<button class="password-game__zoom-target" id="password-zoom-target" type="button" aria-label="Select password clue"></button>
			</div>
		</div>

		<!-- =====================================================
		     CASE NOTES OVERLAY
		====================================================== -->
		<div class="password-game__notebook-overlay" id="password-notebook-overlay" hidden>
			<button class="password-game__notebook-backdrop" id="password-notebook-backdrop" type="button" aria-label="Close case notes"></button>
			<div class="password-game__notebook-large" role="dialog" aria-modal="true" aria-label="Case notes">
				<img src="/public/images/password/Notepad.png" alt="Case notes notebook"/>
				<div class="password-game__notebook-lines" id="password-notebook-lines"></div>
				<p class="password-game__notebook-help">Click outside the notebook to return to the office.</p>
			</div>
		</div>

		<!-- =====================================================
		     GAME MODAL
		====================================================== -->
		<div class="password-game__modal" id="password-game-modal" hidden>
			<div class="password-game__modal-backdrop"></div>
			<section class="password-game__modal-dialog" role="dialog" aria-modal="true" aria-labelledby="password-modal-title">
				<p class="password-game__modal-eyebrow" id="password-modal-eyebrow">PASSWORD INVESTIGATION</p>
				<h1 id="password-modal-title">Passwords &amp; Social Engineering</h1>
				<div class="password-game__modal-content" id="password-modal-content"></div>
				<div class="password-game__modal-actions">
					<button class="password-game__modal-button" id="password-modal-primary" type="button">Continue</button>
				</div>
			</section>
		</div>

		<script src="/public/js/password-game.js"></script>
	</main>
}
