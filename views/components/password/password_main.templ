package password

import (
	"cyber-security-minigames/types"
	"cyber-security-minigames/views/components/ui"
)

templ PasswordMain(view types.PasswordView, guesses []types.Guess, numPositions int, instructions string) {
	<div class="password__container">
		<a class="password__back-arrow" href="/">Back</a>
		<main class={ "password password--" + view.String() }>
			if view == types.PasswordOffice {
				<img src="../../public/images/password/office.png" class="password__image" alt=""/>
			} else {
				<img src="../../public/images/password/desk.jpg" class="password__image" alt=""/>
			}
			if view != types.PasswordOffice {
				<a class="password__back-arrow" href="/password/changeview/0">Back</a>
			}
			switch view {
				case types.PasswordDesk:
					@ObjectContainer(3, 3, types.PasswordNone)
				default:
					@ObjectContainer(0, 3, types.PasswordDesk)
			}
			<!-- @Guess(guesses, numPositions) -->
			<img
				class="password__notebook"
				src="../../../public/images/password/Notepad Icon.png"
				alt=""
				hx-get="/password/gethints"
				hx-swap="afterend"
			/>
		</main>
	</div>
	<div id="modal-root" hx-preserve="true">
		if instructions != "" {
			@ui.Modal(instructions, "", false)
		}
	</div>
}
