package password

import "strconv"

func getFileName(objectId int) string {
	switch objectId {
	case 1:
		return "../../../public/images/password/jersey.png"
	case 2:
		return "../../../public/images/password/calendar.png"
	case 3:
		return "../../../public/images/password/trash.png"
	case 4:
		return "../../../public/images/password/Rufus.png"
	case 5:
		return "../../../public/images/password/drawing.png"
	case 6:
		return "../../../public/images/password/ID 1.png"

	default:
		return "../../../public/images/password/calendar.png"
	}
}

func getHintName(objectId int) string {
	switch objectId {
	case 1:
		return "jersey"
	case 2:
		return "calendar"
	case 3:
		return "trash"
	case 4:
		return "rufus"
	case 5:
		return "drawing"
	case 6:
		return "id"

	default:
		return "desk"
	}

}

templ ObjectCloseUp(object_id int, num_points int) {
	<main class={ "password__object-close-up password__object-close-up--" + strconv.Itoa(object_id) }>
		<img class="password__image" src={ getFileName(object_id) } alt=""/>
		for i := 0; i < num_points; i++ {
			<div
				class={ "password__object-close-up-point password__object-close-up-point--obj-" + strconv.Itoa(object_id) + "-point-" + strconv.Itoa(i) }
				hx-post={ "/password/addhint/" + strconv.Itoa(object_id) + "/" + strconv.Itoa(i) }
				hx-swap="afterend"
			></div>
		}
		<a class="password__back-arrow" href="/password">Back</a>
	</main>
}
