package password

import "strconv"
import "cyber-security-minigames/data"

templ Object(position int) {
	<div
		hx-post={ "/password/addguess/" + data.PasswordObjectPhrases[position] }
		hx-target=".password__guesses"
		hx-swap="outerHTML"
		class={ "password__object password__object--" + strconv.Itoa(position) }
	></div>
}
