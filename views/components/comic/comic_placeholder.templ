package comic

type ComicData struct {
	PanelImages   []string
	ContinueHref  string
	ContinueLabel string
}

templ ComicPage(data ComicData) {
	<main class="comic-page" data-comic-page>
		<div class="comic-page__grid" data-comic-grid>
			for _, imageSrc := range data.PanelImages {
				<div class="comic-page__panel">
					<img
						src={ imageSrc }
						alt="Story comic panel"
					/>
				</div>
			}
		</div>

		<a
			class="comic-page__continue"
			href={ data.ContinueHref }
			hx-boost="false"
			data-comic-continue
		>
			{ data.ContinueLabel }
		</a>
	</main>
}