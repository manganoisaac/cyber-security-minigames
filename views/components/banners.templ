package components

// Six line icons, one per activity, drawn in the same hand (72x72,
// amber stroke, navy banner background) so the set reads as one family.
// Add a new templ func here + a case in Banner() when a new activity
// needs an icon.

templ iconPhishing() {
	<svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
		<rect x="10" y="18" width="44" height="30" rx="3" fill="none" stroke="#e0a45c" stroke-width="2.5"></rect>
		<path d="M10,18 L32,36 L54,18" fill="none" stroke="#e0a45c" stroke-width="2.5"></path>
		<circle cx="52" cy="52" r="10" fill="none" stroke="#e0a45c" stroke-width="2.5"></circle>
		<line x1="59" y1="59" x2="66" y2="66" stroke="#e0a45c" stroke-width="2.5" stroke-linecap="round"></line>
	</svg>
}

templ iconPassword() {
	<svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
		<circle cx="36" cy="28" r="10" fill="none" stroke="#e0a45c" stroke-width="2.5"></circle>
		<path d="M32,36 L24,58 L48,58 L40,36 Z" fill="none" stroke="#e0a45c" stroke-width="2.5" stroke-linejoin="round"></path>
	</svg>
}

templ iconPrivacy() {
	<svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
		<path d="M8,36 C8,36 20,18 36,18 C52,18 64,36 64,36 C64,36 52,54 36,54 C20,54 8,36 8,36 Z" fill="none" stroke="#e0a45c" stroke-width="2.5" stroke-linejoin="round"></path>
		<circle cx="36" cy="36" r="9" fill="none" stroke="#e0a45c" stroke-width="2.5"></circle>
		<circle cx="36" cy="36" r="3" fill="#e0a45c"></circle>
	</svg>
}

templ iconEncryption() {
	<svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
		<rect x="24" y="30" width="24" height="20" rx="3" fill="none" stroke="#e0a45c" stroke-width="2.5"></rect>
		<path d="M28,30 V22 a8,8 0 0 1 16,0 V30" fill="none" stroke="#e0a45c" stroke-width="2.5"></path>
		<circle cx="36" cy="40" r="3" fill="#e0a45c"></circle>
	</svg>
}

templ iconNetwork() {
	<svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
		<path d="M36,10 L58,18 V36 C58,50 48,58 36,62 C24,58 14,50 14,36 V18 Z" fill="none" stroke="#e0a45c" stroke-width="2.5" stroke-linejoin="round"></path>
		<path d="M28,36 L34,42 L46,28" fill="none" stroke="#e0a45c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
}

templ iconInvestigation() {
	<svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
		<path d="M8,22 L28,22 L34,30 L64,30 L64,50 L8,50 Z" fill="none" stroke="#e0a45c" stroke-width="2.5" stroke-linejoin="round"></path>
	</svg>
}

// Banner renders the framed illustration for one activity: a dark banner
// with the icon matching the given slug, corner brackets forming the
// "case file" frame. Slug must match an ActivityLink.Slug in
// views/pages/activities.templ.
templ Banner(slug string) {
	<div class="case-frame">
		<div class="case-illustration">
			switch slug {
				case "phishing":
					@iconPhishing()
				case "password":
					@iconPassword()
				case "privacy":
					@iconPrivacy()
				case "encryption":
					@iconEncryption()
				case "network":
					@iconNetwork()
				case "investigation":
					@iconInvestigation()
			}
		</div>
		<span class="corner corner-tl"></span>
		<span class="corner corner-tr"></span>
		<span class="corner corner-bl"></span>
		<span class="corner corner-br"></span>
	</div>
}

// StatusPill shows red "Incomplete" or green "Complete". completed is a
// plain bool for now — there's no completion-tracking mechanism yet
// (no database, no session state), so every call site currently passes
// false. Wiring this up to real progress is a separate feature to decide
// on (e.g. a signed cookie or in-memory session keyed by activity slug).
templ StatusPill(completed bool) {
	if completed {
		<span class="status-pill status-complete">Complete</span>
	} else {
		<span class="status-pill status-incomplete">Incomplete</span>
	}
}
