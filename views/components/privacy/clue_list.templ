package privacy

import "cyber-security-minigames/types"
import "strconv"

// ClueList is the player's investigation notes beside the feed. oob=true
// swaps it out-of-band after a post is successfully analysed.
templ ClueList(clues []types.ClueUI, analysedCount int, totalPosts int, oob bool) {
	<aside
		id="privacy__clue-list"
		class="clue-list"
		if oob {
			hx-swap-oob="true"
		}
	>
		<h2 class="clue-list__heading">[ INFORMATION DISCOVERED ]</h2>
		<p class="clue-list__progress">
			POSTS ANALYSED
			<strong>{ strconv.Itoa(analysedCount) } / { strconv.Itoa(totalPosts) }</strong>
		</p>
		if len(clues) == 0 {
			<p class="clue-list__empty">Nothing yet. Analyse each post and decide whether it reveals useful personal information.</p>
		} else {
			<dl class="clue-list__items">
				for _, clue := range clues {
					<div class="clue-list__item">
						<dt class="clue-list__key">{ clue.Key }</dt>
						<dd class="clue-list__value">{ clue.Value }</dd>
					</div>
				}
			</dl>
		}
	</aside>
}
