package privacy

import "cyber-security-minigames/types"

// ClueList is the player's own notes beside the feed. It is styled as a
// terminal rather than as part of SnapTrail, so it reads as the
// investigator's tool and not something on Angela's profile. oob=true swaps
// it in out-of-band when a post is collected.
templ ClueList(clues []types.ClueUI, oob bool) {
	<aside
		id="privacy__clue-list"
		class="clue-list"
		if oob {
			hx-swap-oob="true"
		}
	>
		<h2 class="clue-list__heading">[ CLUES FOUND ]</h2>
		if len(clues) == 0 {
			<p class="clue-list__empty">Nothing yet. Click a post that gives away personal information to add it here.</p>
		} else {
			<dl class="clue-list__items">
				for _, clue := range clues {
					<div class="clue-list__item">
						<dt class="clue-list__key">{ clue.Key }</dt>
						<dd class="clue-list__value">{ clue.Value }</dd>
					</div>
				}
			</dl>
		}
	</aside>
}
