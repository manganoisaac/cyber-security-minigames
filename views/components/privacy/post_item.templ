package privacy

import "cyber-security-minigames/types"
import "strconv"

templ PostItem(post types.PostUI) {
	<div
		class="privacy__post-item--container"
		hx-post={ "/privacy/clickpost/" + strconv.Itoa(post.Id) }
		hx-swap="outerHTML"
	>
		<div class="privacy__post-item--avatar">
			<h3>IM</h3>
		</div>
		<div class="privacy__post-item--centre">
			<h2 class="privacy__post-item--author">{ post.Author }</h2>
			<p class="privacy__post-item--content">{ post.Content }</p>
		</div>
		if post.AddedToFolder == true {
			<p>Added To Folder</p>
		}
	</div>
}
