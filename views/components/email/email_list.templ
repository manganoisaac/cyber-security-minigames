package email

import "cyber-security-minigames/types"
import "strings"

templ EmailList(emails []types.Email, selectedIndex int, selectedCount int) {
	<div class="email-list__container" id="email-list-container">
		<div class="email-list">
			<div class="email-list__sidebar">
				for i, email := range emails {
					@EmailItem(i, email, i == selectedIndex)
				}
			</div>
			<div class="email-list__details">
				<p class="email-list__content">
					for i, word := range strings.Split(emails[selectedIndex].Content, " ") {
						@EmailWord(word, false, i, selectedIndex)
					}
				</p>
			</div>
			@EmailSubmit("Submit", selectedCount, false, selectedIndex)
		</div>
	</div>
}
