package email

import "cyber-security-minigames/types"
import "cyber-security-minigames/utils/emailtext"

templ EmailDetails(email types.Email, selectedPhrases map[int]bool, level int, revealed bool) {
	<div class="email-details" id="email-details">
		<p class="email-details__title">
			if level >= 2 {
				@EmailPhrases(email, 0, selectedPhrases, revealed)
			} else {
				{ email.Title }
			}
		</p>
		<div class="email-details__content-container">
			<p class="email-details__to">
				<b>To: </b>
				if level >= 2 {
					@EmailPhrases(email, 1, selectedPhrases, revealed)
				} else {
					{ email.To }
				}
			</p>
			<p class="email-details__from">
				<b>From: </b>
				if level >= 2 {
					@EmailPhrases(email, 2, selectedPhrases, revealed)
				} else {
					{ email.From }
				}
			</p>
			<p class="email-details__description">
				if level >= 2 {
					@EmailPhrases(email, 3, selectedPhrases, revealed)
				} else {
					{ email.Subject }
				}
			</p>
			<p class="email-details__content">
				if level >= 2 {
					@EmailPhrases(email, 4, selectedPhrases, revealed)
				} else {
					for i, phrase := range emailtext.SplitUnits(email.Content) {
						if i > 0 {
							<br/>
							<br/>
						}
						<span>{ phrase }</span>
					}
				}
			</p>
		</div>
	</div>
}

// EmailPhrases renders one field's phrases inline, breaking onto a new line
// between phrases (not just after the last one) so a multi-sentence field
// like Content reads as separate lines instead of one run-on block.
templ EmailPhrases(email types.Email, field int, selectedPhrases map[int]bool, revealed bool) {
	for i, phrase := range emailtext.FieldPhrases(email, field) {
		if i > 0 {
			<br/>
			<br/>
		}
		@EmailPhrase(phrase, selectedPhrases[emailtext.FieldStart(email, field)+i], emailtext.FieldStart(email, field)+i, email.ID, emailtext.CorrectSet(email)[emailtext.FieldStart(email, field)+i], revealed, false)
	}
}