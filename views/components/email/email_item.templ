package email

import "cyber-security-minigames/types"
import "cyber-security-minigames/utils/textutil"

templ EmailItem(email types.Email, active bool, oob bool) {
	<div
		class={ "email-item", templ.KV("email-item--active", active) }
		id={ "email-item-" + email.ID }
		hx-get={ "/email/" + email.ID }
		hx-target="#email-details"
		hx-swap="outerHTML"
		hx-trigger="click[!event.target.closest('.email-item__select')]"
		if oob {
			hx-swap-oob={ "outerHTML:#email-item-" + email.ID }
		}
	>
		@EmailAvatar(email)

		<div class="email-item__text">
			<p class="email-item__sender">{ textutil.TruncateChars(email.From, 42) }</p>
			<p class="email-item__subject">{ textutil.TruncateChars(email.Subject, 52) }</p>
			<p class="email-item__preview">{ textutil.TruncateChars(email.Content, 78) }</p>
		</div>

		<p class="email-item__timestamp">{ email.Timestamp }</p>

		<button
			class="email-item__select"
			type="button"
			hx-post={ "/email-check/" + email.ID }
			hx-target="#modal-root"
			hx-swap="innerHTML"
		>
			SELECT
		</button>
	</div>
}
