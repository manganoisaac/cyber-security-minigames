package email

import "strconv"

templ EmailWord(word string, selected bool, i int, emailIndex int) {
	if selected == true {
		<span
			hx-post={ "/email-word/" + strconv.Itoa(emailIndex) + "/" + strconv.Itoa(i) + "/deselect/" + word }
			hx-swap="outerHTML"
			id={ "email-word-" + strconv.Itoa(i) }
			class="email-word--selected"
		>{ word }</span>{ " " }
	} else {
		<span
			hx-post={ "/email-word/" + strconv.Itoa(emailIndex) + "/" + strconv.Itoa(i) + "/select/" + word }
			hx-swap="outerHTML"
			class="email-word"
			id={ "email-word-" + strconv.Itoa(i) }
		>{ word }</span>{ " " }
	}
}
