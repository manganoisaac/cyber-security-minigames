package email

templ EmailSubmit(label string, selectedCount int, oob bool, emailID string) {
	<button
		id="email-submit"
		hx-post={ "/email-submit/" + emailID }
		hx-target="#modal-root"
		hx-swap="innerHTML"
		if oob {
			hx-swap-oob="true"
		}
		class="email-submit"
	>
		{ label }
	</button>
}
