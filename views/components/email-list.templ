package components

import "cyber-security-minigames/data"
import "strings"

templ EmailList(selectedID int) {
	<div class="email-list-container" id="email-list-container">
		<div class="email-sidebar">
			for i, email := range data.EmailContent {
				@EmailItem(i, email, i == selectedID)
			}
		</div>
		<div class="email-details">
			<p class="email-content">
				for i, word := range strings.Split(data.EmailContent[selectedID].Content, " ") {
					@EmailWord(word, false, i)
				}
			</p>
		</div>
	</div>
}
